# Inquiry email via Mailgun (the only approved email service). Set in Vercel → Settings → Environment Variables.
# Required:
MAILGUN_API_KEY=
# Optional (safe defaults shown; same variable names as Southeast Feed):
# MAILGUN_DOMAIN=autumnstar.ca
# QUOTE_TO=admin@autumnstar.ca
# QUOTE_FROM=Autumn Star <admin@autumnstar.ca>
# MAILGUN_API_BASE=https://api.mailgun.net   # US region (default); EU accounts: https://api.eu.mailgun.net
