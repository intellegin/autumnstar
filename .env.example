# Inquiry email via Mailgun (the only approved email service). Set in Vercel → Settings → Environment Variables.
# Required:
MAILGUN_API_KEY=
QUOTE_TO=
# Optional (defaults shown):
# MAILGUN_DOMAIN=mail.autumnstar.ca
# MAILGUN_API_BASE=https://api.mailgun.net   # EU accounts: https://api.eu.mailgun.net
# QUOTE_FROM=Autumn Star <quotes@mail.autumnstar.ca>
