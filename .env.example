# Form email via Mailgun, sent from the site's own verified domain with a DOMAIN SENDING KEY
# (the app only calls POST /v3/<domain>/messages). Set in Vercel → Settings → Environment Variables.
# Required (forms answer "not configured" without them):
MAILGUN_API_KEY=
QUOTE_TO=
# Recommended:
MAILGUN_DOMAIN=autumnstar.ca
# Optional (defaults shown):
# QUOTE_FROM=Autumn Star <admin@autumnstar.ca>
# MAILGUN_API_BASE=https://api.mailgun.net   # EU accounts: https://api.eu.mailgun.net (other values ignored in production)
